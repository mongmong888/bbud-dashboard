# GA4 속성 ID
GA4_WEB_PROPERTY_ID=
GA4_MARKETING_PROPERTY_ID=

# GA4 서비스 계정 인증 — 로컬 개발과 배포 환경 중 하나만 채우면 된다.
# 로컬 개발: 서비스 계정 JSON 키 파일의 절대 경로
GOOGLE_APPLICATION_CREDENTIALS_PATH=
# 배포(Vercel 등): 서비스 계정 JSON 키 파일의 전체 내용을 한 줄 문자열로
GOOGLE_SERVICE_ACCOUNT_KEY=

# 노션 연동 (푸시 알림 발송 이력)
NOTION_API_KEY=
NOTION_PUSH_PAGE_ID=

# Vercel Blob (회원 현황 업로드 데이터 저장) — Vercel 대시보드에서 Blob 스토어를 만들면 자동 발급됨
BLOB_READ_WRITE_TOKEN=
